<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBEBEB"
    android:fitsSystemWindows="true"
    tools:context=".OutageActivity">

    <!-- Status Bar Spacer -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Menu -->
    <ImageView
        android:id="@+id/top_menu"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rectangle_rad25dp"
        android:backgroundTint="#FFFFFF"
        android:outlineProvider="background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_spacer" />

    <TextView
        android:id="@+id/outage_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Outage"
        android:textSize="23dp"
        android:textStyle="bold"
        android:textColor="#666666"
        app:layout_constraintBottom_toBottomOf="@+id/top_menu"
        app:layout_constraintStart_toStartOf="@+id/top_menu"
        app:layout_constraintEnd_toStartOf="@+id/notification_icon"
        app:layout_constraintTop_toTopOf="@+id/top_menu"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_menu"
        app:layout_constraintEnd_toStartOf="@+id/user_picture"
        app:layout_constraintTop_toTopOf="@+id/top_menu"
        app:srcCompat="@drawable/bell_svgrepo_com"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/user_picture"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/top_menu"
        app:layout_constraintEnd_toEndOf="@+id/top_menu"
        app:layout_constraintTop_toTopOf="@+id/top_menu"
        app:srcCompat="@drawable/user_circle_svgrepo_com"
        android:layout_marginEnd="16dp" />

    <!-- Main Content Scroll View -->
    <ScrollView
        android:id="@+id/background_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="Outage content scroll view"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottom_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_menu"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Map Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/map_card"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rectangle_rad25dp"
                android:backgroundTint="#FFFFFF"
                android:outlineProvider="background"
                android:padding="16dp">

                <!-- Map Area Placeholder -->
                <View
                    android:id="@+id/map_area"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@drawable/rectangle_rad25dp"
                    android:backgroundTint="#F0F8FF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/map_legend"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/map_placeholder_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interactive Outage Map"
                    android:textColor="#8A8A8A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/map_area"
                    app:layout_constraintEnd_toEndOf="@+id/map_area"
                    app:layout_constraintStart_toStartOf="@+id/map_area"
                    app:layout_constraintTop_toTopOf="@+id/map_area" />

                <!-- Map Legend -->
                <LinearLayout
                    android:id="@+id/map_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="20dp">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#15C3A0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Electricity"
                            android:textColor="#1A1A1A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="20dp">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#FF6B6A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gas"
                            android:textColor="#1A1A1A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#70A7F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Water"
                            android:textColor="#1A1A1A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Current Outages Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Current Outages"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter"
                    android:textColor="#4A90E2"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Outages List -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/outages_list_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rectangle_rad25dp"
                android:backgroundTint="#FFFFFF"
                android:outlineProvider="background"
                android:padding="16dp">

                <!-- Outage Item 1 - Electricity (Active) -->
                <LinearLayout
                    android:id="@+id/outage_item_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Status Indicator -->
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#FF6B6B"
                        android:layout_marginEnd="12dp" />

                    <!-- Utility Icon -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#E7F6EE" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/hydropower_coal_svgrepo_com"
                        android:layout_marginStart="-30dp" />

                    <!-- Outage Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Electricity Outage"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE"
                                android:textColor="#FF6B6B"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/rectangle_rad25dp"
                                android:backgroundTint="#FFEBEE"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gulshan, Dhaka"
                            android:textColor="#8A8A8A"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:00 AM - 2:00 PM • May 26, 2025"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <!-- Outage Range -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Range: 3.2 km radius"
                            android:textColor="#FF6B6B"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#FFEBEE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider_1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    app:layout_constraintTop_toBottomOf="@+id/outage_item_1"
                    android:layout_marginVertical="8dp" />

                <!-- Outage Item 2 - Water (Active) -->
                <LinearLayout
                    android:id="@+id/outage_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/divider_1">

                    <!-- Status Indicator -->
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#FF6B6B"
                        android:layout_marginEnd="12dp" />

                    <!-- Utility Icon -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#E3F2FD" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/water_fee_svgrepo_com"
                        android:layout_marginStart="-30dp" />

                    <!-- Outage Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Water Outage"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE"
                                android:textColor="#FF6B6B"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/rectangle_rad25dp"
                                android:backgroundTint="#FFEBEE"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dhanmondi, Dhaka"
                            android:textColor="#8A8A8A"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2:00 PM - 6:00 PM • May 26, 2025"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <!-- Outage Range -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Range: 2.8 km radius"
                            android:textColor="#FF6B6B"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#FFEBEE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider_2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    app:layout_constraintTop_toBottomOf="@+id/outage_item_2"
                    android:layout_marginVertical="8dp" />

                <!-- Outage Item 3 - Gas (Scheduled) -->
                <LinearLayout
                    android:id="@+id/outage_item_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/divider_2">

                    <!-- Status Indicator -->
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#FFC107"
                        android:layout_marginEnd="12dp" />

                    <!-- Utility Icon -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#FFEAEA" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/gas_costs_svgrepo_com"
                        android:layout_marginStart="-30dp" />

                    <!-- Outage Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Gas Maintenance"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SCHEDULED"
                                android:textColor="#FF8F00"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/rectangle_rad25dp"
                                android:backgroundTint="#FFF8E1"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mirpur, Dhaka"
                            android:textColor="#8A8A8A"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8:00 AM - 12:00 PM • May 28, 2025"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <!-- Outage Range -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Range: 1.5 km radius"
                            android:textColor="#FF8F00"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#FFF8E1"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider_3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    app:layout_constraintTop_toBottomOf="@+id/outage_item_3"
                    android:layout_marginVertical="8dp" />

                <!-- Outage Item 4 - Electricity (Resolved) -->
                <LinearLayout
                    android:id="@+id/outage_item_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/divider_3">

                    <!-- Status Indicator -->
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginEnd="12dp" />

                    <!-- Utility Icon -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/rectangle_rad25dp"
                        android:backgroundTint="#E7F6EE" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/hydropower_coal_svgrepo_com"
                        android:layout_marginStart="-30dp" />

                    <!-- Outage Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Electricity Outage"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RESOLVED"
                                android:textColor="#4CAF50"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/rectangle_rad25dp"
                                android:backgroundTint="#E8F5E8"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Uttara, Dhaka"
                            android:textColor="#8A8A8A"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6:00 AM - 9:00 AM • May 25, 2025"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <!-- Outage Range -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Range: 4.1 km radius"
                            android:textColor="#4CAF50"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/rectangle_rad25dp"
                            android:backgroundTint="#E8F5E8"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Quick Stats -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rectangle_rad25dp"
                android:backgroundTint="#FFFFFF"
                android:outlineProvider="background"
                android:padding="20dp">

                <TextView
                    android:id="@+id/stats_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outage Statistics"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/stats_title">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="#FF6B6B"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#FF8F00"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scheduled"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#4CAF50"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolved"
                            android:textColor="#4CAF50"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bottom Padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Menu -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rectangle_rad25dp_half"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="16dp">

        <!-- Navigation Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Bill Button -->
            <LinearLayout
                android:id="@+id/nav_recharge"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/recharge_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/bill_list_svgrepo_com" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bill"
                    android:textColor="#8A8A8A"
                    android:textSize="7.5sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Meter Button -->
            <LinearLayout
                android:id="@+id/nav_meter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/meter_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/spedometer_max_svgrepo_com" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meter"
                    android:textColor="#8A8A8A"
                    android:textSize="7.5sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Home Button -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/home_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/home_svgrepo_com" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#8A8A8A"
                    android:textSize="7.5sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Map Button (Active) -->
            <LinearLayout
                android:id="@+id/nav_map"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/rectangle_rad25dp"
                android:backgroundTint="#E3F2FD">

                <ImageView
                    android:id="@+id/map_button"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:srcCompat="@drawable/streets_map_point_svgrepo_com" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outage"
                    android:textColor="#4A90E2"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/setting_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/settings_minimalistic_svgrepo_com" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#8A8A8A"
                    android:textSize="7.5sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>